# SmartPosture mobile app — environment configuration
#
# Copy this file to `.env` and adjust the values for your setup.
# Expo only inlines variables prefixed with EXPO_PUBLIC_.
#
# Every request goes through src/api/client.ts, which reads the values below
# from src/config/appConfig.ts. No screen hardcodes a backend address.

# Base origin of the SmartPosture backend (no trailing slash, no /api/v1).
# Physical Android/iOS device on the same Wi-Fi as the computer running the
# backend: use that computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.125.202.96:3000

# Android emulator: the host machine is reachable at 10.0.2.2, not 127.0.0.1.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Fixed wearable identifier shared with the ESP32 firmware.
EXPO_PUBLIC_DEVICE_ID=posture-belt-01
